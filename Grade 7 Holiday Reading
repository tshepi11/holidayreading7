t and because he was not wrong.", "Eighty-nine percent does mean eleven percent you cannot do. That is simply what it means."], ["## Thirteen", "“The question was fine,” she says. “What I did with it was not.”"], ["“I turned one sentence into a way of living, at twelve, without telling anybody, and then spent five years avoiding everything I might be bad at. And the whole time my marks looked excellent, so nobody had the slightest reason to ask.”"]], "wc": 682, "words": [{"w": "percent", "m": "out of every hundred"}, {"w": "genuinely", "m": "really and truly"}, {"w": "system", "m": "an organised way of doing something"}, {"w": "example", "m": "a person or thing held up to be copied"}, {"w": "ambitious", "m": "aiming at something big or difficult"}, {"w": "sensible", "m": "showing good judgement"}, {"w": "predicted", "m": "said in advance what would happen"}, {"w": "reasonable", "m": "fair and sensible"}, {"w": "average", "m": "the middle amount of several numbers"}, {"w": "avoiding", "m": "keeping away from"}]}];
const KEY = "g7-holiday";
let state={}, cur=-1, pg=0, fs=19, mode="listen";
const VOICE = ("speechSynthesis" in window);

async function load(){
  try{const r=await window.storage.get(KEY);state=r?JSON.parse(r.value):{};return;}catch(e){}
  try{const v=window.localStorage.getItem(KEY);state=v?JSON.parse(v):{};}catch(e){state={};}
}
async function save(){
  try{if(window.storage){await window.storage.set(KEY,JSON.stringify(state));return;}}catch(e){}
  try{window.localStorage.setItem(KEY,JSON.stringify(state));}catch(e){}
}
function say(t){
  if(!VOICE) return;
  window.speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(t); u.rate=.72; u.lang="en-ZA";
  window.speechSynthesis.speak(u);
}
function drawShelf(){
  const el=document.getElementById("shelf"); el.innerHTML="";
  BOOKS.forEach((b,i)=>{
    const st=state[i]||{};
    const btn=document.createElement("button"); btn.className="book";
    let tag="";
    if(st.best!==undefined) tag=`<span class="badge">Spelling ${st.best}/${b.words.length}</span>`;
    else if(st.page) tag=`<span class="resume">Carry on &#8212; page ${st.page+1}</span>`;
    btn.innerHTML=`<span class="spine"><small style="font-size:11px;display:block;font-family:IBM Plex Mono,monospace;letter-spacing:.08em">DAY</small>${b.n}</span><span>
      <span class="bt">${b.title}</span><span class="bb">${b.blurb}</span>
      <span class="meta"><span>24 pages</span><span>${b.wc} words</span>${tag}</span></span>`;
    btn.addEventListener("click",()=>open(i));
    el.appendChild(btn);
  });
}
function open(i){
  cur=i; pg=(state[i]&&state[i].page)?state[i].page:0;
  document.getElementById("shelfview").classList.add("off");
  document.getElementById("reader").classList.add("on");
  document.getElementById("rtitle").textContent=BOOKS[i].title;
  document.getElementById("novoice").classList.toggle("on",!VOICE);
  if(!VOICE) setMode("mean"); else setMode(mode);
  draw(); window.scrollTo(0,0);
}
function draw(){
  const b=BOOKS[cur], last=pg>=b.pages.length;
  document.getElementById("storyview").style.display=last?"none":"block";
  document.getElementById("sp").classList.toggle("on",last);
  if(!last){
    document.getElementById("page").innerHTML=b.pages[pg].map(l=>
      l.startsWith("## ")?`<h2 class="chap">${l.slice(3)}</h2>`:`<p>${l}</p>`).join("");
    document.getElementById("pnum").textContent=`${pg+1} of ${b.pages.length}`;
    document.getElementById("prev").disabled=pg===0;
    document.getElementById("next").textContent=pg===b.pages.length-1?"Spelling test":"Next";
    document.getElementById("bar").style.width=((pg+1)/b.pages.length*100)+"%";
  }
  state[cur]=Object.assign({},state[cur],{page:Math.min(pg,b.pages.length-1)});
  save();
}
function setMode(m){
  mode=m;
  document.getElementById("mListen").setAttribute("aria-pressed",m==="listen");
  document.getElementById("mMean").setAttribute("aria-pressed",m==="mean");
  document.getElementById("si").textContent = m==="listen"
    ? "Press Say it. The laptop reads a word from the book out loud. Type it, then press Check."
    : "Read what the word means. Write the word. The first letter and the number of letters are given to help you.";
  buildItems();
}
function buildItems(){
  const b=BOOKS[cur], el=document.getElementById("items"); el.innerHTML="";
  b.words.forEach((it,i)=>{
    const d=document.createElement("div"); d.className="item";
    const top = mode==="listen"
      ? `<button class="say" data-w="${it.w}">&#9654; Say it</button>
         <span class="clue hint" id="h${i}"></span>`
      : `<span class="clue">${it.m}
         <span class="hint">&nbsp;&nbsp;${it.w[0].toUpperCase()} &#183; ${it.w.length} letters</span></span>`;
    d.innerHTML=`<div class="itop"><span class="n">${i+1}.</span>${top}</div>
      <div class="ans"><input type="text" autocomplete="off" autocapitalize="off"
        spellcheck="false" aria-label="Word ${i+1}"><span class="tick" id="t${i}"></span></div>`;
    el.appendChild(d);
  });
  el.querySelectorAll(".say").forEach((btn,i)=>{
    btn.addEventListener("click",()=>{
      say(btn.dataset.w);
      document.getElementById("h"+i).textContent = btn.dataset.w.length + " letters";
    });
  });
  document.getElementById("score").classList.remove("on");
}
function check(){
  const b=BOOKS[cur], inputs=document.querySelectorAll("#items input");
  let right=0;
  inputs.forEach((inp,i)=>{
    const ok=inp.value.trim().toLowerCase()===b.words[i].w.toLowerCase();
    inp.classList.toggle("ok",ok);
    inp.classList.toggle("no",!ok&&inp.value.trim()!=="");
    const t=document.getElementById("t"+i);
    t.textContent=ok?"\u2713":(inp.value.trim()?"\u2717":"");
    t.className="tick "+(ok?"ok":"no");
    if(ok) right++;
  });
  const n=b.words.length, s=document.getElementById("score");
  let msg;
  if(right===n) msg=`<b>${right} out of ${n}.</b> Every single one. Go and tell somebody.`;
  else if(right>=n-2) msg=`<b>${right} out of ${n}.</b> Nearly all of them. Try the red ones once more.`;
  else if(right>=n/2) msg=`<b>${right} out of ${n}.</b> Good going. Sound out the red ones slowly.`;
  else msg=`<b>${right} out of ${n}.</b> Try the other button &#8212; it gives you the meaning and the first letter.`;
  s.innerHTML=msg; s.classList.add("on");
  const prev=(state[cur]&&state[cur].best)||0;
  state[cur]=Object.assign({},state[cur],{best:Math.max(prev,right)});
  save();
}
document.getElementById("next").addEventListener("click",()=>{if(pg<BOOKS[cur].pages.length){pg++;draw();window.scrollTo(0,0);}});
document.getElementById("prev").addEventListener("click",()=>{if(pg>0){pg--;draw();window.scrollTo(0,0);}});
document.getElementById("back").addEventListener("click",()=>{
  if(VOICE) window.speechSynthesis.cancel();
  document.getElementById("reader").classList.remove("on");
  document.getElementById("shelfview").classList.remove("off");
  drawShelf(); window.scrollTo(0,0);});
document.getElementById("check").addEventListener("click",check);
document.getElementById("clear").addEventListener("click",buildItems);
document.getElementById("reread").addEventListener("click",()=>{pg=0;draw();window.scrollTo(0,0);});
document.getElementById("mListen").addEventListener("click",()=>setMode("listen"));
document.getElementById("mMean").addEventListener("click",()=>setMode("mean"));
document.getElementById("bigger").addEventListener("click",()=>{fs=Math.min(fs+2,31);
  document.documentElement.style.setProperty("--fs",fs+"px");});
document.getElementById("smaller").addEventListener("click",()=>{fs=Math.max(fs-2,15);
  document.documentElement.style.setProperty("--fs",fs+"px");});
document.addEventListener("keydown",e=>{
  if(!document.getElementById("reader").classList.contains("on")) return;
  if(document.activeElement.tagName==="INPUT") return;
  if(e.key==="ArrowRight") document.getElementById("next").click();
  if(e.key==="ArrowLeft") document.getElementById("prev").click();});
load().then(drawShelf);
</script>
