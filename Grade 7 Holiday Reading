<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Grade 7 Holiday Reading</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Lora:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{--ink:#1A1814;--soft:#6B6355;--paper:#FBF7EF;--card:#FFF;--rule:#E3DCCC;
 --accent:#5B3A8E;--accent-l:#EEE8F6;--good:#2E7D4F;--bad:#C0392B;--fs:19px}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{background:var(--paper);color:var(--ink);font-family:"Lora",Georgia,serif;
 line-height:1.65;padding:0 0 70px}
.wrap{max-width:760px;margin:0 auto;padding:0 20px}
button{font-family:inherit;cursor:pointer}
header{padding:34px 0 22px;border-bottom:3px solid var(--ink)}
.kicker{font-family:"IBM Plex Mono",monospace;font-size:11px;font-weight:600;
 letter-spacing:.16em;text-transform:uppercase;color:var(--soft)}
h1{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;
 font-size:clamp(32px,7vw,54px);line-height:.96;letter-spacing:-.02em;margin:10px 0 12px}
.lede{font-size:15px;color:var(--soft);max-width:54ch}
.shelf{display:grid;gap:14px;margin-top:26px}
.book{display:grid;grid-template-columns:64px 1fr;gap:16px;align-items:start;background:var(--card);
 border:1.5px solid var(--rule);border-radius:3px;padding:16px 18px;text-align:left;width:100%}
.book:hover{border-color:var(--accent)}
.book:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.spine{background:var(--accent);border-radius:2px;height:88px;display:flex;flex-direction:column;align-items:center;
 justify-content:center;line-height:1;font-family:"Bricolage Grotesque",sans-serif;font-weight:800;
 font-size:30px;color:#fff}
.bt{font-family:"Bricolage Grotesque",sans-serif;font-weight:600;font-size:20px;
 line-height:1.15;margin-bottom:5px}
.bb{font-size:14px;color:var(--soft);line-height:1.5;margin-bottom:9px}
.meta{display:flex;gap:14px;align-items:center;flex-wrap:wrap;font-family:"IBM Plex Mono",monospace;
 font-size:11px;color:var(--soft);letter-spacing:.05em;text-transform:uppercase}
.badge{background:var(--good);color:#fff;padding:3px 8px;border-radius:2px;font-weight:600}
.resume{background:var(--accent-l);color:var(--accent);padding:3px 8px;border-radius:2px;font-weight:600}
.reader{display:none}.reader.on{display:block}.shelfview.off{display:none}
.rbar{display:flex;align-items:center;gap:12px;padding:16px 0;border-bottom:1.5px solid var(--rule);flex-wrap:wrap}
.back{background:none;border:0;font-family:"IBM Plex Mono",monospace;font-size:12px;
 letter-spacing:.08em;text-transform:uppercase;color:var(--soft);padding:6px 0}
.rtitle{font-family:"Bricolage Grotesque",sans-serif;font-weight:600;font-size:16px;flex:1}
.sizer{display:flex;border:1.5px solid var(--rule);border-radius:2px;overflow:hidden}
.sizer button{background:var(--card);border:0;padding:5px 11px;font-size:13px;
 font-family:"IBM Plex Mono",monospace;color:var(--soft)}
.sizer button+button{border-left:1.5px solid var(--rule)}
.pagewrap{min-height:46vh;display:flex;align-items:center;padding:34px 0 10px}
.page{font-size:var(--fs);line-height:1.85}
.page p{margin-bottom:1.05em}.page p:last-child{margin-bottom:0}
.chap{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:.72em;
 letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-bottom:1.1em}
.nav{display:flex;align-items:center;gap:14px;padding:16px 0 0;border-top:1.5px solid var(--rule)}
.nav button{background:var(--ink);color:var(--paper);border:0;border-radius:2px;padding:11px 22px;
 font-family:"IBM Plex Mono",monospace;font-size:12px;letter-spacing:.09em;
 text-transform:uppercase;font-weight:600}
.nav button[disabled]{opacity:.28;cursor:default}
.pnum{flex:1;text-align:center;font-family:"IBM Plex Mono",monospace;font-size:12px;color:var(--soft)}
.bar{height:5px;background:var(--rule);margin-top:14px}
.bar i{display:block;height:100%;background:var(--accent);width:0;transition:width .25s}
.sp{display:none;padding-top:8px}.sp.on{display:block}
.sh{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:26px;margin:26px 0 6px}
.si{font-size:15px;color:var(--soft);margin-bottom:20px;max-width:56ch}
.mode{display:flex;border:1.5px solid var(--ink);border-radius:2px;overflow:hidden;
 width:max-content;margin-bottom:22px}
.mode button{background:transparent;border:0;padding:9px 16px;font-family:"IBM Plex Mono",monospace;
 font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;font-weight:600;color:var(--ink)}
.mode button+button{border-left:1.5px solid var(--ink)}
.mode button[aria-pressed="true"]{background:var(--ink);color:var(--paper)}
.item{padding:14px 0;border-bottom:1px solid var(--rule)}
.itop{display:flex;gap:12px;align-items:center;margin-bottom:9px}
.n{font-family:"IBM Plex Mono",monospace;font-size:13px;color:var(--soft);min-width:24px}
.say{background:var(--accent-l);color:var(--accent);border:1.5px solid var(--accent);
 border-radius:2px;padding:7px 14px;font-family:"IBM Plex Mono",monospace;font-size:12px;
 letter-spacing:.06em;text-transform:uppercase;font-weight:600}
.say:hover{background:var(--accent);color:#fff}
.clue{font-size:16px;line-height:1.55;flex:1}
.ans{display:flex;gap:10px;align-items:center;padding-left:36px}
.ans input{font-family:"Lora",serif;font-size:17px;padding:9px 11px;flex:1;max-width:300px;
 border:1.5px solid var(--rule);border-radius:2px;background:var(--card);color:var(--ink)}
.ans input:focus{outline:0;border-color:var(--accent)}
.ans input.ok{border-color:var(--good);background:#F2F9F5}
.ans input.no{border-color:var(--bad);background:#FDF3F2}
.tick{font-size:19px}.tick.ok{color:var(--good)}.tick.no{color:var(--bad)}
.hint{font-family:"IBM Plex Mono",monospace;font-size:13px;letter-spacing:.2em;color:var(--soft)}
.acts{display:flex;gap:10px;margin-top:24px;flex-wrap:wrap}
.acts button{border:1.5px solid var(--ink);background:var(--ink);color:var(--paper);border-radius:2px;
 padding:11px 20px;font-family:"IBM Plex Mono",monospace;font-size:12px;letter-spacing:.09em;
 text-transform:uppercase;font-weight:600}
.acts button.ghost{background:transparent;color:var(--ink)}
.score{margin-top:22px;padding:16px 18px;background:var(--accent-l);border-left:4px solid var(--accent);
 font-size:16px;display:none}
.score.on{display:block}
.novoice{font-size:13px;color:var(--bad);margin-bottom:16px;display:none}
.novoice.on{display:block}
@media(max-width:560px){.book{grid-template-columns:46px 1fr;gap:12px}.spine{height:70px;font-size:24px}
 .ans{padding-left:0}.itop{flex-wrap:wrap}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="wrap">
<div class="shelfview" id="shelfview">
  <header>
    <div class="kicker">Grade 7 · Holidays</div>
    <h1>Holiday Reading</h1>
    <p class="lede">One book for each day of the holidays. Each one is 24 pages, and there is a vocabulary check at the back when you finish.</p>
  </header>
  <div class="shelf" id="shelf"></div>
</div>

<div class="reader" id="reader">
  <div class="rbar">
    <button class="back" id="back">&#8592; Shelf</button>
    <span class="rtitle" id="rtitle"></span>
    <span class="sizer">
      <button id="smaller" aria-label="Smaller text">A&#8722;</button>
      <button id="bigger" aria-label="Bigger text">A+</button>
    </span>
  </div>
  <div id="storyview">
    <div class="pagewrap"><div class="page" id="page"></div></div>
    <div class="nav">
      <button id="prev">Back</button>
      <span class="pnum" id="pnum"></span>
      <button id="next">Next</button>
    </div>
    <div class="bar"><i id="bar"></i></div>
  </div>
  <div class="sp" id="sp">
    <div class="sh">Vocabulary Check</div>
    <p class="si" id="si"></p>
    <div class="mode" role="group" aria-label="Choose how to practise">
      <button id="mListen" aria-pressed="true">Listen &amp; type</button>
      <button id="mMean" aria-pressed="false">What is the word?</button>
    </div>
    <p class="novoice" id="novoice">This browser will not read the words out. Use <b>What is the word?</b> instead, or ask a grown-up to read them to you.</p>
    <div id="items"></div>
    <div class="acts">
      <button id="check">Check my answers</button>
      <button class="ghost" id="clear">Clear</button>
      <button class="ghost" id="reread">Read it again</button>
    </div>
    <div class="score" id="score"></div>
  </div>
</div>
